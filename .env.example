# Admin login (username is case-insensitive)
ADMIN_USERNAME=lotusadmin
# Generate with: npm run hash-password -- 'your-new-password'
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...$...
# Random string, at least 32 characters. Changing it logs everyone out.
SESSION_SECRET=
# Added automatically when a Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=
